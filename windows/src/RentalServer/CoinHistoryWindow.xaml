<Window x:Class="RentalServer.CoinHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coin History"
        Height="560"
        Width="780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Coin History"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <!-- Date picker row -->
        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="Showing:" VerticalAlignment="Center" />
            <DatePicker x:Name="DatePicker"
                        AutomationProperties.AutomationId="DatePicker"
                        Width="160"
                        Margin="8,0,12,0"
                        SelectedDateChanged="OnDateChanged" />
            <Button x:Name="TodayButton"
                    AutomationProperties.AutomationId="TodayButton"
                    Width="80"
                    Margin="0,0,12,0"
                    Click="OnTodayClicked"
                    Content="Today" />
            <Button x:Name="RefreshButton"
                    AutomationProperties.AutomationId="RefreshButton"
                    Width="90"
                    Click="OnRefreshClicked"
                    Content="Refresh" />
        </StackPanel>

        <!-- Grid: plain-language columns only. No JSON, no event_type
             enum, no hash columns. -->
        <DataGrid x:Name="HistoryGrid"
                  AutomationProperties.AutomationId="HistoryGrid"
                  Grid.Row="2"
                  Margin="0,16,0,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="80" />
                <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="100" />
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="100" />
                <DataGridTextColumn Header="Time added" Binding="{Binding AddedText}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{Binding AddedForeground}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals strip -->
        <TextBlock x:Name="TotalsText"
                   AutomationProperties.AutomationId="TotalsText"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   FontSize="14"
                   Foreground="#222"
                   Text="(no rows)" />
    </Grid>
</Window>
