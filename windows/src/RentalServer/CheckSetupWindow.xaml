<Window x:Class="RentalServer.CheckSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check setup"
        Width="760" Height="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Check setup"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <Border Grid.Row="1"
                x:Name="SummaryBorder"
                Margin="0,4,0,12"
                Padding="12,8"
                CornerRadius="6"
                Background="#FFF8FAFC"
                BorderBrush="#FFE2E8F0"
                BorderThickness="1">
            <TextBlock x:Name="SummaryText"
                       Text="Checking..."
                       FontSize="14"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding AreaHeader}"
                                       Visibility="{Binding AreaHeaderVisibility}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FF0F172A"
                                       Margin="0,10,0,4" />
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    CornerRadius="6"
                                    Background="{Binding Background}"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left"
                                            Padding="6,2"
                                            CornerRadius="4"
                                            Background="{Binding BadgeBrush}">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="13"
                                                   Foreground="#FF475569"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding FixText}"
                                                   Visibility="{Binding FixVisibility}"
                                                   FontSize="13"
                                                   Foreground="#FF1E3A8A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3"
                   Margin="0,14,0,0"
                   LastChildFill="False">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Left"
                    Width="110"
                    Click="OnRefreshClicked"
                    Content="Check again" />
            <Button x:Name="CopyReportButton"
                    DockPanel.Dock="Left"
                    Width="120"
                    Margin="8,0,0,0"
                    Click="OnCopyReportClicked"
                    Content="Copy report"
                    ToolTip="Copies a short summary (no passwords, no PC names) to paste in the Slotify Facebook group." />
            <TextBlock x:Name="CopiedText"
                       DockPanel.Dock="Left"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FF16A34A"
                       Text="" />
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Width="80"
                    Click="OnCloseClicked"
                    Content="Close" />
        </DockPanel>
    </Grid>
</Window>
