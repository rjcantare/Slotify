<Window x:Class="RentalServer.TransactionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transactions"
        Height="640"
        Width="1080"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filters row -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="From:" VerticalAlignment="Center" />
            <DatePicker x:Name="FromDatePicker"
                        AutomationProperties.AutomationId="FromDatePicker"
                        Width="130"
                        Margin="6,0,4,0" />
            <TextBox x:Name="FromTimeTextBox"
                     AutomationProperties.AutomationId="FromTimeTextBox"
                     Width="64"
                     Margin="0,0,12,0"
                     ToolTip="HH:mm local — blank means 00:00 (start of day)"
                     Text="00:00" />

            <TextBlock Text="To:" VerticalAlignment="Center" />
            <DatePicker x:Name="ToDatePicker"
                        AutomationProperties.AutomationId="ToDatePicker"
                        Width="130"
                        Margin="6,0,4,0" />
            <TextBox x:Name="ToTimeTextBox"
                     AutomationProperties.AutomationId="ToTimeTextBox"
                     Width="64"
                     Margin="0,0,12,0"
                     ToolTip="HH:mm local — blank means 23:59:59.999 (end of day, inclusive)"
                     Text="23:59" />

            <TextBlock Text="Type:" VerticalAlignment="Center" />
            <ComboBox x:Name="EventTypeBox"
                      AutomationProperties.AutomationId="EventTypeBox"
                      Width="160"
                      Margin="6,0,12,0" />

            <TextBlock Text="Station:" VerticalAlignment="Center" />
            <TextBox x:Name="StationTextBox"
                     AutomationProperties.AutomationId="StationTextBox"
                     Width="100"
                     Margin="6,0,12,0" />

            <Button x:Name="RefreshButton"
                    AutomationProperties.AutomationId="RefreshButton"
                    Width="100"
                    Margin="0,0,12,0"
                    Click="OnRefreshClicked"
                    Content="Refresh" />
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="EventGrid"
                  AutomationProperties.AutomationId="EventGrid"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Ts}" Width="180" />
                <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="140" />
                <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="90" />
                <DataGridTextColumn Header="Acceptor" Binding="{Binding AcceptorId}" Width="90" />
                <DataGridTextColumn Header="₱" Binding="{Binding AmountPesos}" Width="60" />
                <DataGridTextColumn Header="Seconds" Binding="{Binding SecondsCredited}" Width="80" />
                <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals strip -->
        <TextBlock x:Name="TotalsText"
                   AutomationProperties.AutomationId="TotalsText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#444"
                   Text="(no rows)" />

        <!-- Footer actions -->
        <DockPanel Grid.Row="3"
                   Margin="0,12,0,0"
                   LastChildFill="True">
            <Button x:Name="ExportCsvButton"
                    AutomationProperties.AutomationId="ExportCsvButton"
                    Width="120"
                    Margin="0,0,8,0"
                    DockPanel.Dock="Left"
                    Click="OnExportCsvClicked"
                    Content="Export CSV" />

            <Button x:Name="VerifyChainButton"
                    AutomationProperties.AutomationId="VerifyChainButton"
                    Width="140"
                    Margin="0,0,8,0"
                    DockPanel.Dock="Left"
                    Click="OnVerifyChainClicked"
                    Content="Verify Hash Chain" />

            <TextBlock x:Name="ChainStatusText"
                       AutomationProperties.AutomationId="ChainStatusText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#444" />
        </DockPanel>
    </Grid>
</Window>
