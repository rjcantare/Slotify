<Window x:Class="RentalServer.TabletAppImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Import Tablet Apps"
        Width="960" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InventoryText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,10">
            <Button Width="92"
                    Margin="0,0,8,8"
                    Click="OnSelectAllClicked"
                    Content="Select All" />
            <Button Width="92"
                    Margin="0,0,18,8"
                    Click="OnUncheckAllClicked"
                    Content="Uncheck All" />
            <Button Width="86"
                    Margin="0,0,8,8"
                    Click="OnSelectGamesClicked"
                    Content="Games" />
            <Button Width="116"
                    Margin="0,0,8,8"
                    Click="OnSelectVideoSocialClicked"
                    Content="Video &amp; Social" />
            <Button Width="86"
                    Margin="0,0,8,8"
                    Click="OnSelectBrowserClicked"
                    Content="Browser" />
            <Button Width="86"
                    Margin="0,0,8,8"
                    Click="OnSelectToolsClicked"
                    Content="Tools" />
            <Button Width="86"
                    Margin="0,0,8,8"
                    Click="OnSelectOtherClicked"
                    Content="Other" />
        </WrapPanel>

        <DataGrid x:Name="ImportGrid"
                  AutomationProperties.AutomationId="TabletAppImportGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#FFE2E8F0"
                                    Padding="8,4"
                                    Margin="0,8,0,2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF0F172A" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <!-- Single operator toggle: importing an app also shows it on the
                     tablet. CheckBox lives in a CellTemplate (not a
                     DataGridCheckBoxColumn) so it toggles on ONE click instead of
                     requiring the cell to enter edit mode first. -->
                <DataGridTemplateColumn Header="Include" Width="80" SortMemberPath="Include">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="Import this app and show it on the tablet"
                                      AutomationProperties.AutomationId="TabletAppImportIncludeCheckBox" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding DisplayName, Mode=OneWay}"
                                    Width="190" />
                <DataGridTextColumn Header="Package"
                                    Binding="{Binding PackageName, Mode=OneWay}"
                                    Width="*" />
                <DataGridComboBoxColumn Header="Category"
                                        SelectedValueBinding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="DisplayName"
                                        SelectedValuePath="Value"
                                        Width="140" />
                <DataGridTemplateColumn Header="Deep Freeze" Width="110" SortMemberPath="DeepFreeze">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding DeepFreeze, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="Clear this app's data when the session ends (leave OFF for games)"
                                      AutomationProperties.AutomationId="TabletAppImportDeepFreezeCheckBox" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   AutomationProperties.AutomationId="TabletAppImportStatusText"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#C62828"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ImportButton"
                    AutomationProperties.AutomationId="TabletAppImportSaveButton"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="OnImportClicked"
                    Content="Import" />
            <Button x:Name="CancelButton"
                    AutomationProperties.AutomationId="TabletAppImportCancelButton"
                    Width="100"
                    Click="OnCancelClicked"
                    Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
