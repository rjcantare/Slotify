<Window x:Class="RentalServer.TabletAppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tablet Apps"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Allowed tablet apps"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <DataGrid x:Name="AppGrid"
                   AutomationProperties.AutomationId="TabletAppGrid"
                   Grid.Row="1"
                   AutoGenerateColumns="False"
                   CanUserAddRows="False"
                   HeadersVisibility="Column"
                   GridLinesVisibility="Horizontal"
                   RowHeaderWidth="0"
                   SelectionMode="Single">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#FFE2E8F0"
                                    Padding="8,4"
                                    Margin="0,8,0,2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF0F172A" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Show"
                                        Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70" />
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="180" />
                <DataGridTextColumn Header="Android Package"
                                    Binding="{Binding PackageName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="*" />
                <DataGridComboBoxColumn Header="Category"
                                        SelectedValueBinding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="DisplayName"
                                        SelectedValuePath="Value"
                                        Width="140" />
                <DataGridCheckBoxColumn Header="Deep Freeze"
                                        Binding="{Binding DeepFreeze, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button x:Name="AddButton"
                    AutomationProperties.AutomationId="TabletAppAddButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnAddClicked"
                    Content="Add" />
            <Button x:Name="RemoveButton"
                    AutomationProperties.AutomationId="TabletAppRemoveButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnRemoveClicked"
                    Content="Remove" />
            <Button x:Name="RemoveAllButton"
                    AutomationProperties.AutomationId="TabletAppRemoveAllButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnRemoveAllClicked"
                    Content="Remove All" />
            <Button x:Name="EditButton"
                    AutomationProperties.AutomationId="TabletAppEditButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnEditClicked"
                    Content="Edit" />
            <Button x:Name="ImportButton"
                    AutomationProperties.AutomationId="TabletAppImportButton"
                    Width="138"
                    Margin="0,0,8,0"
                    Click="OnImportClicked"
                    Content="Import From Tablet" />
        </StackPanel>

        <DockPanel Grid.Row="3"
                   Margin="0,14,0,0"
                   LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                        AutomationProperties.AutomationId="TabletAppSaveButton"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="OnSaveClicked"
                        Content="Save" />
                <Button x:Name="CancelButton"
                        AutomationProperties.AutomationId="TabletAppCancelButton"
                        Width="100"
                        Click="OnCancelClicked"
                        Content="Cancel" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       AutomationProperties.AutomationId="TabletAppStatusText"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#C62828" />
        </DockPanel>
    </Grid>
</Window>
