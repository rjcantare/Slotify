<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RentalShared\RentalShared.csproj" />
    <ProjectReference Include="..\RentalServer.Core\RentalServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- mDNS / DNS-SD broker advertising for Wi-Fi devices. Maintained fork of
         richardschneider/net-mdns; targets net8.0 (the original
         Makaretu.Dns.Multicast is netstandard2.0-only and unmaintained). -->
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.1.0</Version>
    <ApplicationIcon>Slotify.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Slotify.ico" />
  </ItemGroup>

</Project>
