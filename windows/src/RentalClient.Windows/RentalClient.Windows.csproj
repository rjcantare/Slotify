<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- mDNS / DNS-SD broker discovery, for parity with the server + Wi-Fi clients. -->
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RentalShared\RentalShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.1.0</Version>
    <ApplicationIcon>Slotify.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Slotify.ico" />
    <!-- Brand logos baked onto the customer-facing lock + active-session screens. -->
    <Resource Include="Assets\slotify-logo.png" />
    <Resource Include="Assets\slotify-mark.png" />
  </ItemGroup>

</Project>
