<Window x:Class="RentalClient.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Slotify Client" Icon="Slotify.ico" Height="360" Width="560"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="Rental Client" />

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Ellipse x:Name="StatusIndicator"
                     Width="18"
                     Height="18"
                     Fill="#C62828"
                     Stroke="#66000000"
                     StrokeThickness="1" />
            <TextBlock x:Name="StatusText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Text="Not connected" />
            <Border Margin="16,0,0,0"
                    Padding="8,3"
                    CornerRadius="4"
                    Background="#EEEEEE">
                <TextBlock x:Name="ConnectionModeText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="OFFLINE"
                           ToolTip="Connection state" />
            </Border>
        </StackPanel>

        <StackPanel x:Name="DiagnosticPanel"
                    Grid.Row="2"
                    Margin="30,12,0,16"
                    Visibility="Collapsed">
            <TextBlock x:Name="StationText"
                       TextWrapping="Wrap"
                       Foreground="#666666"
                       Text="Station: (loading config)" />
            <TextBlock x:Name="BrokerText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="#666666"
                       Text="Broker: (loading config)" />
            <TextBlock x:Name="SessionText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Text="Session: (waiting for first message)" />
            <TextBlock x:Name="ClaimText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       Text="Claim: (idle)" />
            <TextBlock x:Name="DetailText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="#666666" />
        </StackPanel>

        <StackPanel x:Name="ButtonPanel"
                    Grid.Row="4"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
            <TextBlock x:Name="DebugModeText"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#AD1457"
                       Visibility="Collapsed"
                       Text="Debug: lock overlay disabled" />
            <Button x:Name="InsertCoinMainButton"
                    AutomationProperties.AutomationId="InsertCoinMainButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="OnMainInsertCoinClicked"
                    Content="Insert Coin" />
            <Button x:Name="AddTimeMainButton"
                    AutomationProperties.AutomationId="AddTimeMainButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="OnMainAddTimeClicked"
                    Content="Add Time"
                    Visibility="Collapsed" />
            <Button x:Name="DoneMainButton"
                    AutomationProperties.AutomationId="DoneMainButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnMainDoneClicked"
                    Content="Done"
                    IsEnabled="False" />
            <Button Width="110"
                    Click="OnRetryClicked"
                    Content="Retry" />
        </StackPanel>

        <Border x:Name="ToastBorder"
                Grid.Row="0"
                Grid.RowSpan="5"
                Visibility="Collapsed"
                Background="#FF2E7D32"
                CornerRadius="6"
                Padding="20,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,4,4">
            <TextBlock x:Name="ToastText"
                       Text=""
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="14" />
        </Border>
    </Grid>
</Window>
