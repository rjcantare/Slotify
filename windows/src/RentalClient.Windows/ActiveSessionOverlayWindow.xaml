<Window x:Class="RentalClient.Windows.ActiveSessionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rental Session"
        Width="260"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0.78"
        MouseEnter="OnMouseEntered"
        MouseLeave="OnMouseLeft">
    <Window.Resources>
        <!-- Rainbow LED-frame cue: one looping rotation of the gradient's
             RelativeTransform. Started/stopped from UpdateState (Granted only),
             mirroring the coin box's physical RGB frame during a coin window. -->
        <Storyboard x:Key="RainbowSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RainbowRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:4" />
        </Storyboard>
        <!-- Flat action button: own template so the disabled state is a frosted
             muted tone that fits the card, not the system washed-out grey. -->
        <Style x:Key="OverlayActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
      Compact Slotify session widget (navy/gold brand pass).
      - SizeToContent="Height" so the card hugs its content in either state.
      - Whole-Border MouseLeftButtonDown is the drag handle; inner Buttons capture
        their own mouse-down so clicks aren't swallowed by DragMove.
      - RainbowFrame is a non-hit-testable overlay over the card edge; UpdateState
        thickens it + spins it while a coin window is open. Window.Opacity is the
        only transparency knob; the gradient + borders use fully-opaque #FF colors.
    -->
    <Grid>
        <Border x:Name="OuterBorder"
                CornerRadius="12"
                BorderBrush="#FF2A3654"
                BorderThickness="1"
                Padding="13,9,13,11"
                MouseLeftButtonDown="OnDragHandleMouseDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1B2640" Offset="0" />
                    <GradientStop Color="#FF131D33" Offset="0.5" />
                    <GradientStop Color="#FF0E1626" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  Direction="270"
                                  ShadowDepth="3"
                                  Opacity="0.4"
                                  Color="#FF05080F" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="False">
                    <Border DockPanel.Dock="Left"
                            Background="#FFF7F8FB"
                            CornerRadius="5"
                            Padding="3,2"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                        <Image Source="/Assets/slotify-mark.png"
                               Width="14"
                               Height="14"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="StationText"
                               DockPanel.Dock="Left"
                               Foreground="#FFFCD34D"
                               FontSize="9"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="TIME REMAINING" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Border x:Name="UpdateBadge"
                                Width="30"
                                Height="18"
                                Padding="0"
                                Margin="0,0,6,0"
                                CornerRadius="9"
                                Background="#F2FFFFFF"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                ToolTip=""
                                PreviewMouseLeftButtonDown="OnUpdateBadgePreviewMouseDown"
                                MouseLeftButtonUp="OnUpdateBadgeClicked"
                                AutomationProperties.AutomationId="ActiveOverlayUpdateBadge">
                            <TextBlock x:Name="UpdateBadgeText"
                                       Foreground="#FFBE185D"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="" />
                        </Border>
                        <Ellipse x:Name="ConnectionDot"
                                 Width="9"
                                 Height="9"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="#FF2E7D32"
                                 Stroke="#55FFFFFF"
                                 StrokeThickness="1"
                                 ToolTip="Connection state" />
                        <Button x:Name="ExpandButton"
                                AutomationProperties.AutomationId="ExpandButton"
                                Width="20"
                                Height="16"
                                Margin="0,0,4,0"
                                Padding="0"
                                Foreground="White"
                                Background="Transparent"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="8"
                                Content="&#xE922;"
                                ToolTip="Expand"
                                Click="OnExpandClicked" />
                        <Button x:Name="MinimizeButton"
                                AutomationProperties.AutomationId="MinimizeButton"
                                Width="20"
                                Height="16"
                                Padding="0"
                                Foreground="White"
                                Background="Transparent"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="8"
                                Content="&#xE921;"
                                ToolTip="Minimize"
                                Click="OnMinimizeClicked" />
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="RemainingText"
                           Grid.Row="1"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="29"
                           FontWeight="Bold"
                           Text="00:00:00" />

                <Grid Grid.Row="2"
                      Margin="0,8,0,0"
                      Height="3">
                    <Border Background="#44FFFFFF" CornerRadius="1.5" />
                    <Border x:Name="ProgressFill"
                            Background="#FFF4C04C"
                            CornerRadius="1.5"
                            HorizontalAlignment="Left"
                            Width="0" />
                </Grid>

                <Border x:Name="TimeEndingWarningBanner"
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        CornerRadius="5"
                        Padding="8,5"
                        Background="#FFD97706"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TimeEndingWarningText"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="TIME ALMOST UP" />
                </Border>

                <Border x:Name="ExpandedSeparator"
                        Grid.Row="4"
                        Height="1"
                        Margin="0,10,0,0"
                        Background="#33FFFFFF"
                        Visibility="Collapsed" />

                <StackPanel x:Name="ExpandedPanel"
                            Grid.Row="5"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="AddTimeAccumulationText"
                               Margin="0,0,0,7"
                               HorizontalAlignment="Center"
                               Foreground="#FFFCD34D"
                               FontFamily="Consolas, Courier New, monospace"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"
                               Text="&#8369;0 +00:00:00" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="AddTimeButton"
                                AutomationProperties.AutomationId="AddTimeButton"
                                Style="{StaticResource OverlayActionButton}"
                                Width="68"
                                Margin="0,0,5,0"
                                Background="#FFF4C04C"
                                BorderBrush="#FFCDA23C"
                                Foreground="#FF1E2436"
                                Content="Add Time"
                                Click="OnAddTimeClicked" />
                        <Button x:Name="DoneButton"
                                AutomationProperties.AutomationId="DoneButton"
                                Style="{StaticResource OverlayActionButton}"
                                Width="52"
                                Margin="0,0,5,0"
                                Background="#FF16A34A"
                                BorderBrush="#FF15803D"
                                Content="Done"
                                IsEnabled="False"
                                Click="OnDoneClicked" />
                        <Button x:Name="ClearTimeButton"
                                AutomationProperties.AutomationId="ClearTimeButton"
                                Style="{StaticResource OverlayActionButton}"
                                Width="68"
                                Background="#FFDC2626"
                                BorderBrush="#FFB91C1C"
                                Content="Clear Time"
                                Click="OnClearTimeClicked" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="RainbowFrame"
                CornerRadius="12"
                BorderThickness="0"
                IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="RainbowRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFFF2D2D" Offset="0.0" />
                    <GradientStop Color="#FF19C819" Offset="0.1667" />
                    <GradientStop Color="#FF2F6BFF" Offset="0.3333" />
                    <GradientStop Color="#FFA23BD6" Offset="0.5" />
                    <GradientStop Color="#FFFFE000" Offset="0.6667" />
                    <GradientStop Color="#FF1FE0E0" Offset="0.8333" />
                    <GradientStop Color="#FFFF2D2D" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
    </Grid>
</Window>
