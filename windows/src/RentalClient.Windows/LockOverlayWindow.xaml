<Window x:Class="RentalClient.Windows.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RentalLock"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FF0E1626"
        Foreground="White">
    <Window.Resources>
        <!-- Rainbow LED-frame cue: one looping rotation of the gradient's
             RelativeTransform. Render-thread/GPU composited, so it doesn't peg
             the UI thread. Started/stopped from UpdateClaimState (Granted only). -->
        <Storyboard x:Key="RainbowSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RainbowRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:4" />
        </Storyboard>
    </Window.Resources>

    <!-- RainbowFrame border is 0-thickness at rest; UpdateClaimState thickens it
         and starts the spin while a coin window is open, mirroring the physical
         acrylic RGB frame on the coin box. -->
    <Border x:Name="RainbowFrame" BorderThickness="0">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform x:Name="RainbowRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FFFF2D2D" Offset="0.0" />
                <GradientStop Color="#FF19C819" Offset="0.1667" />
                <GradientStop Color="#FF2F6BFF" Offset="0.3333" />
                <GradientStop Color="#FFA23BD6" Offset="0.5" />
                <GradientStop Color="#FFFFE000" Offset="0.6667" />
                <GradientStop Color="#FF1FE0E0" Offset="0.8333" />
                <GradientStop Color="#FFFF2D2D" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Margin="24">
                <Border x:Name="UpdateBadge"
                        Padding="10,4"
                        CornerRadius="4"
                        Background="#1976D2"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        ToolTip=""
                        MouseLeftButtonUp="OnUpdateBadgeClicked"
                        AutomationProperties.AutomationId="LockOverlayUpdateBadge">
                    <TextBlock x:Name="UpdateBadgeText"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="" />
                </Border>
                <Ellipse x:Name="ConnectionBadge"
                         Width="18"
                         Height="18"
                         Margin="10,0,0,0"
                         Fill="#FFB71C1C"
                         Stroke="#66000000"
                         StrokeThickness="1"
                         ToolTip="Connection state" />
            </StackPanel>

            <Button x:Name="AdminButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="24"
                    Padding="16,8"
                    Background="#22000000"
                    BorderBrush="#44FFFFFF"
                    Foreground="#CCFFFFFF"
                    Content="Admin"
                    Click="OnAdminClicked" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Slotify brand logo baked onto the lock screen. The logo art is
                     dark navy, so it sits on a light chip to stay legible on the
                     navy kiosk background. -->
                <Border Background="#FFF7F8FB"
                        CornerRadius="18"
                        Padding="30,18"
                        HorizontalAlignment="Center">
                    <Image Source="/Assets/slotify-logo.png"
                           Height="92"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="PC + Tablet Rental"
                           FontSize="22"
                           Foreground="#FF93A4C0"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,20" />
                <TextBlock x:Name="StationLabel"
                           Text=""
                           FontSize="18"
                           Foreground="#FF6B7A93"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="RemainingText"
                           Text="00:00:00"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#FFF4C04C"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="RateInfoText"
                           Text=""
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#FFF4C04C"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           MaxWidth="1100"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,28,0,0">
                    <Button x:Name="InsertCoinButton"
                            AutomationProperties.AutomationId="InsertCoinButton"
                            Content="INSERT COIN"
                            FontSize="32"
                            FontWeight="Bold"
                            Padding="40,14"
                            Background="#FFF4C04C"
                            Foreground="#FF1E2436"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnInsertCoinClicked" />
                    <Button x:Name="DoneButton"
                            AutomationProperties.AutomationId="DoneButton"
                            Content="DONE"
                            FontSize="32"
                            FontWeight="Bold"
                            Padding="40,14"
                            Margin="16,0,0,0"
                            Background="#FF16A34A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="OnDoneClicked" />
                </StackPanel>
                <TextBlock x:Name="RunningTotalText"
                           Text=""
                           FontSize="24"
                           Foreground="#FFF4C04C"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ClaimStatusText"
                           Text=""
                           FontSize="18"
                           Foreground="#FF9E9E9E"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           MaxWidth="900"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock x:Name="AutoShutdownText"
                           Text=""
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFFFB020"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Visibility="Collapsed" />
                <TextBlock Text="by RomansTechSolutions"
                           FontSize="12"
                           Foreground="#FF3A4761"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
